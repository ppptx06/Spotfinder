datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model User {
  id           Int       @id @default(autoincrement()) @map("user_id")
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  userType     String    @default("STUDENT") @map("user_type") // STUDENT | REMOTE_WORKER | HIGH_SCHOOL_STUDENT | ADMIN
  createdAt    DateTime  @default(now()) @map("created_at")
  isVerified   Boolean   @default(false) @map("is_verified")

  adminProfile Admin?
  reviews      Review[]

  @@map("users")
}

model Admin {
  id          Int      @id @default(autoincrement()) @map("admin_id")
  userId      Int      @unique @map("user_id")
  accessLevel String   @default("MODERATOR") @map("access_level") // MODERATOR | CONTENT_MANAGER | SUPERADMIN
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  moderatedReviews Review[] @relation("AdminModerated")

  @@map("admins")
}

model StudySpot {
  id             Int      @id @default(autoincrement()) @map("spot_id")
  name           String
  address        String
  operatingHours String?  @map("operating_hours")
  latitude       Float
  longitude      Float
  overallRating  Float    @default(0.0) @map("overall_rating")
  imageUrl       String?  @map("image_url")
  spotType       String   @default("library") @map("spot_type") // library | cafe | studyRoom
  createdAt      DateTime @default(now()) @map("created_at")

  // Subtypes
  library   Library?
  cafe      Cafe?
  studyRoom StudyRoom?

  // Infrastructure metrics
  wifiInfo   WifiInfo?
  seating    Seating?
  noiseLevel NoiseLevel?
  outlets    Outlet[]
  reviews    Review[]

  @@index([latitude, longitude], name: "idx_spot_geo")
  @@map("study_spots")
}

model Library {
  spotId            Int      @id @map("spot_id")
  silentStudyArea   Boolean  @default(true) @map("silent_study_area")
  bookReservation   Boolean  @default(false) @map("book_reservation")
  publicAccess      Boolean  @default(true) @map("public_access")
  floorCount        Int      @default(1) @map("floor_count")
  campusAffiliation String?  @map("campus_affiliation")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("libraries")
}

model Cafe {
  spotId             Int      @id @map("spot_id")
  outletAvailability String   @default("FEW") @map("outlet_availability") // NONE | FEW | ABUNDANT
  avgCoffeePrice     Float?   @map("avg_coffee_price")
  minOrderRequired   Boolean  @default(false) @map("min_order_required")
  hasFoodMenu        Boolean  @default(true) @map("has_food_menu")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("cafes")
}

model StudyRoom {
  spotId            Int      @id @map("spot_id")
  maxCapacity       Int      @map("max_capacity")
  reservationPolicy String?  @map("reservation_policy")
  hasWhiteboard     Boolean  @default(true) @map("has_whiteboard")
  hasProjector      Boolean  @default(false) @map("has_projector")
  hourlyRate        Float    @default(0.0) @map("hourly_rate")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("study_rooms")
}

model WifiInfo {
  id            Int     @id @default(autoincrement()) @map("wifi_id")
  spotId        Int     @unique @map("spot_id")
  speedMbps     Float?  @map("speed_mbps")
  securityType  String? @map("security_type")
  qualityRating Int?    @map("quality_rating")
  isFree        Boolean @default(true) @map("is_free")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("wifi_info")
}

model Outlet {
  id         Int     @id @default(autoincrement()) @map("outlet_id")
  spotId     Int     @map("spot_id")
  type       String
  count      Int     @default(0)
  accessible Boolean @default(true)
  isWorking  Boolean @default(true) @map("is_working")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("outlets")
}

model Seating {
  id             Int     @id @default(autoincrement()) @map("seating_id")
  spotId         Int     @unique @map("spot_id")
  availableSeats Int     @default(0) @map("available_seats")
  totalSeats     Int     @map("total_seats")
  comfortLevel   String? @map("comfort_level")

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("seating")
}

model NoiseLevel {
  id            Int     @id @default(autoincrement()) @map("noise_id")
  spotId        Int     @unique @map("spot_id")
  decibelLevel  Int?    @map("decibel_level")
  noiseCategory String  @default("QUIET") @map("noise_category") // SILENT | QUIET | LIVELY

  spot StudySpot @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@map("noise_levels")
}

model Review {
  id            Int      @id @default(autoincrement()) @map("review_id")
  userId        Int?     @map("user_id")
  spotId        Int      @map("spot_id")
  authorName    String   @default("Аноним") @map("author_name")
  comment       String?
  rating        Float
  timestamp     DateTime @default(now())
  isApproved    Boolean  @default(true) @map("is_approved")
  moderatedById Int?     @map("moderated_by_id")

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  spot        StudySpot  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  moderatedBy Admin?     @relation("AdminModerated", fields: [moderatedById], references: [id])

  @@map("reviews")
}
